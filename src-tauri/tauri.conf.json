{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shion",
  "version": "0.3.0",
  "identifier": "dev.shion.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Shion",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3RTIwNkNEMEEwQTQ0MTkKUldRWlJBb0t6UWJpaDVEZTNjcXpsWmttTTJveWdMQTFjaEpGRDZNY1dmRlQ3ZUJvTEUzMENuMmMK",
      "endpoints": [
        "https://github.com/kyles-arch/shion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
